@model PagedResultSet<MovieCardModel>
<div class="container-fluid my-4">
    <!-- row-cols-2 = 2 per row on mobile, row-cols-md-4 = 4 on tablet, row-cols-lg-6 = 6 on desktop -->
    <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
        @foreach (var movie in Model.results)
        {
            <div class="col">
                <partial name="_MovieCard" model="movie" />
            </div>
        }
    </div>


<!-- Pagination Controls -->
    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination pagination-sm justify-content-start">

            <!-- First Page (<<) -->
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-controller="Movies" asp-action="Genre" asp-route-id="@ViewBag.GenreId" asp-route-pageNumber="1">&laquo;</a>
            </li>

            <!-- Previous Page (<) -->
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-controller="Movies" asp-action="Genre" asp-route-id="@ViewBag.GenreId" asp-route-pageNumber="@(Model.PageIndex - 1)">&lsaquo;</a>
            </li>

            <!-- First Few Pages (1, 2, 3, 4, 5) -->
            @for (int i = 1; i <= Math.Min(5, Model.TotalPages); i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-controller="Movies" asp-action="Genre" asp-route-id="@ViewBag.GenreId" asp-route-pageNumber="@i">@i</a>
                </li>
            }

            <!-- Ellipsis (...) if total pages exceed displayed limit -->
            @if (Model.TotalPages > 5)
            {
                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>

                <!-- Last Page Number (e.g., 69) -->
                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "active" : "")">
                    <a class="page-link" asp-controller="Movies" asp-action="Genre" asp-route-id="@ViewBag.GenreId" asp-route-pageNumber="@Model.TotalPages">@Model.TotalPages</a>
                </li>
            }

            <!-- Next Page (>) -->
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-controller="Movies" asp-action="Genre" asp-route-id="@ViewBag.GenreId" asp-route-pageNumber="@(Model.PageIndex + 1)">&rsaquo;</a>
            </li>

            <!-- Last Page (>>) -->
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-controller="Movies" asp-action="Genre" asp-route-id="@ViewBag.GenreId" asp-route-pageNumber="@Model.TotalPages">&raquo;</a>
            </li>

        </ul>
    </nav>
</div>